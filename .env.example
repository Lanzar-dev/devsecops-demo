# Copy to .env and fill in real values. NEVER commit the real .env.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Which task/user store to use: "memory" (tests/local) or "prisma" (PostgreSQL)
REPOSITORY_DRIVER=memory

# PostgreSQL (used when REPOSITORY_DRIVER=prisma)
DATABASE_URL=postgresql://taskuser:changeme@localhost:5432/tasks?schema=public

# JWT signing secret (use a long random value; rotate regularly)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m

# CORS allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
